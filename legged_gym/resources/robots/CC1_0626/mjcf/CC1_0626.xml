<mujoco model="Lite3_cc1">
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="robot">
      <default class="motor">
        <joint/>
        <motor/>
      </default>
      <default class="visual">
        <geom material="visualgeom" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom material="collision_material" condim="3" contype="0" conaffinity="1"
              group="1" solref="0.005 1" friction="1 0.01 0.01"/>
        <equality solimp="0.99 0.999 1e-05" solref="0.005 1"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="visualgeom" rgba="1 1 1 1"/>
    <material name="collision_material" rgba="0 0.4 0.8 0.2"/>

    <!-- The URDF torso STL has 687896 faces, above MuJoCo's 200000-face limit. -->
    <mesh name="torso" file="../../CC1/meshes/robot_dog_simplified.STL"/>
    <mesh name="fl_hip" file="../meshes/fl_hip.STL"/>
    <mesh name="fl_thigh" file="../meshes/fl_thigh.STL"/>
    <mesh name="fl_shank" file="../meshes/fl_shank_collision.obj"/>
    <mesh name="fr_hip" file="../meshes/fr_hip.STL"/>
    <mesh name="fr_thigh" file="../meshes/fr_thigh.STL"/>
    <mesh name="fr_shank" file="../meshes/fr_shank_collision.obj"/>
    <mesh name="hl_hip" file="../meshes/hl_hip.STL"/>
    <mesh name="hl_thigh" file="../meshes/hl_thigh.STL"/>
    <mesh name="hl_shank" file="../meshes/hl_shank_collision.obj"/>
    <mesh name="hr_hip" file="../meshes/hr_hip.STL"/>
    <mesh name="hr_thigh" file="../meshes/hr_thigh.STL"/>
    <mesh name="hr_shank" file="../meshes/hr_shank_collision.obj"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <body name="TORSO" pos="0 0 1" childclass="robot">
      <freejoint name="floating_base"/>
      <site name="imu_site" pos="0 0 0" size="0.005" rgba="1 0 0 1"/>
      <inertial pos="0 0 0" mass="7.794" diaginertia="0.02351 0.05282 0.06716"/>
      <geom name="TORSO_collision" type="mesh" mesh="torso" class="collision"/>
      <geom name="TORSO_visual" type="mesh" mesh="torso" class="visual"/>

      <!-- Front-left leg -->
      <body name="FL_HIP" pos="0.16 0.0767 0">
        <joint name="FL_HipX_joint" type="hinge" class="motor" axis="-1 0 0"
               range="-0.5236 0.5236" damping="0.01" frictionloss="0.03"/>
        <inertial pos="-0.010579 -0.011358 0.00048546" mass="0.668"
                  diaginertia="0.0003949 0.0004028 0.0004472"/>
        <geom name="FL_HIP_collision" type="mesh" mesh="fl_hip" class="collision"/>
        <geom name="FL_HIP_visual" type="mesh" mesh="fl_hip" class="visual"/>
        <body name="FL_THIGH" pos="0 0.0855 0">
          <joint name="FL_HipY_joint" type="hinge" class="motor" axis="0 -1 0"
                 range="-2.792 1.57" damping="0.01" frictionloss="0.03"/>
          <inertial pos="-0.0052817 -0.014632 -0.042672" mass="1.291"
                    diaginertia="0.006136 0.005306 0.001536"/>
          <geom name="FL_THIGH_collision" type="mesh" mesh="fl_thigh" class="collision"/>
          <geom name="FL_THIGH_visual" type="mesh" mesh="fl_thigh" class="visual"/>
          <body name="FL_SHANK" pos="0 0 -0.2">
            <joint name="FL_Knee_joint" type="hinge" class="motor" axis="0 -1 0"
                   range="0.5236 2.5831" damping="0.01" frictionloss="0.03"/>
            <inertial pos="0.0064794 -1.4535e-06 -0.12157" mass="0.18211"
                      diaginertia="0.00089039 0.00090672 3.1266e-05"/>
            <geom name="FL_SHANK_collision" type="mesh" mesh="fl_shank" class="collision"/>
            <geom name="FL_SHANK_visual" type="mesh" mesh="fl_shank" class="visual"/>
            <body name="FL_FOOT" pos="0 0 -0.22">
              <inertial pos="0 0 0" mass="0.06" diaginertia="1e-12 1e-12 1e-12"/>
              <geom name="FL_FOOT_collision" type="sphere" size="0.02" class="collision"/>
              <geom name="FL_FOOT_visual" type="sphere" size="0.022" class="visual"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Front-right leg -->
      <body name="FR_HIP" pos="0.16 -0.0767 0">
        <joint name="FR_HipX_joint" type="hinge" class="motor" axis="-1 0 0"
               range="-0.5236 0.5236" damping="0.01" frictionloss="0.03"/>
        <inertial pos="-0.010579 0.011358 0.00048546" mass="0.668"
                  diaginertia="0.0003949 0.0004028 0.0004472"/>
        <geom name="FR_HIP_collision" type="mesh" mesh="fr_hip" class="collision"/>
        <geom name="FR_HIP_visual" type="mesh" mesh="fr_hip" class="visual"/>
        <body name="FR_THIGH" pos="0 -0.0855 0">
          <joint name="FR_HipY_joint" type="hinge" class="motor" axis="0 -1 0"
                 range="-2.792 1.57" damping="0.01" frictionloss="0.03"/>
          <inertial pos="-0.0039245 0.025256 -0.025146" mass="1.297"
                    diaginertia="0.006136 0.005306 0.001536"/>
          <geom name="FR_THIGH_collision" type="mesh" mesh="fr_thigh" class="collision"/>
          <geom name="FR_THIGH_visual" type="mesh" mesh="fr_thigh" class="visual"/>
          <body name="FR_SHANK" pos="0 0 -0.2">
            <joint name="FR_Knee_joint" type="hinge" class="motor" axis="0 -1 0"
                   range="0.5236 2.7225" damping="0.01" frictionloss="0.03"/>
            <inertial pos="0.0064794 -1.4552e-06 -0.12157" mass="0.18206"
                      diaginertia="0.00089039 0.00090672 3.1266e-05"/>
            <geom name="FR_SHANK_collision" type="mesh" mesh="fr_shank" class="collision"/>
            <geom name="FR_SHANK_visual" type="mesh" mesh="fr_shank" class="visual"/>
            <body name="FR_FOOT" pos="0 0 -0.22">
              <inertial pos="0 0 0" mass="0.06" diaginertia="1e-12 1e-12 1e-12"/>
              <geom name="FR_FOOT_collision" type="sphere" size="0.02" class="collision"/>
              <geom name="FR_FOOT_visual" type="sphere" size="0.022" class="visual"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Hind-left leg -->
      <body name="HL_HIP" pos="-0.16 0.0767 0">
        <joint name="HL_HipX_joint" type="hinge" class="motor" axis="-1 0 0"
               range="-0.5236 0.5236" damping="0.01" frictionloss="0.03"/>
        <inertial pos="0.010905 -0.012636 0.001051" mass="0.668"
                  diaginertia="0.0003949 0.0004028 0.0004472"/>
        <geom name="HL_HIP_collision" type="mesh" mesh="hl_hip" class="collision"/>
        <geom name="HL_HIP_visual" type="mesh" mesh="hl_hip" class="visual"/>
        <body name="HL_THIGH" pos="0 0.0855 0">
          <joint name="HL_HipY_joint" type="hinge" class="motor" axis="0 -1 0"
                 range="-2.792 1.57" damping="0.01" frictionloss="0.03"/>
          <inertial pos="-0.0057137 -0.014631 -0.042453" mass="1.291"
                    diaginertia="0.006136 0.005306 0.001536"/>
          <geom name="HL_THIGH_collision" type="mesh" mesh="hl_thigh" class="collision"/>
          <geom name="HL_THIGH_visual" type="mesh" mesh="hl_thigh" class="visual"/>
          <body name="HL_SHANK" pos="0 0 -0.2">
            <joint name="HL_Knee_joint" type="hinge" class="motor" axis="0 -1 0"
                   range="0.5236 2.7225" damping="0.01" frictionloss="0.03"/>
            <inertial pos="0.0064794 -1.4558e-06 -0.12157" mass="0.18211"
                      diaginertia="0.00089039 0.00090672 3.1266e-05"/>
            <geom name="HL_SHANK_collision" type="mesh" mesh="hl_shank" class="collision"/>
            <geom name="HL_SHANK_visual" type="mesh" mesh="hl_shank" class="visual"/>
            <body name="HL_FOOT" pos="0 0 -0.22">
              <inertial pos="0 0 0" mass="0.06" diaginertia="1e-12 1e-12 1e-12"/>
              <geom name="HL_FOOT_collision" type="sphere" size="0.02" class="collision"/>
              <geom name="HL_FOOT_visual" type="sphere" size="0.022" class="visual"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Hind-right leg -->
      <body name="HR_HIP" pos="-0.16 -0.0767 0">
        <joint name="HR_HipX_joint" type="hinge" class="motor" axis="-1 0 0"
               range="-0.5236 0.5236" damping="0.01" frictionloss="0.03"/>
        <inertial pos="0.010354 0.011423 0.00049498" mass="0.668"
                  diaginertia="0.0003949 0.0004028 0.0004472"/>
        <geom name="HR_HIP_collision" type="mesh" mesh="hr_hip" class="collision"/>
        <geom name="HR_HIP_visual" type="mesh" mesh="hr_hip" class="visual"/>
        <body name="HR_THIGH" pos="0 -0.0855 0">
          <joint name="HR_HipY_joint" type="hinge" class="motor" axis="0 -1 0"
                 range="-2.792 1.57" damping="0.01" frictionloss="0.03"/>
          <inertial pos="-0.0031903 0.02526 -0.025617" mass="1.291"
                    diaginertia="0.006136 0.005306 0.001536"/>
          <geom name="HR_THIGH_collision" type="mesh" mesh="hr_thigh" class="collision"/>
          <geom name="HR_THIGH_visual" type="mesh" mesh="hr_thigh" class="visual"/>
          <body name="HR_SHANK" pos="0 0 -0.2">
            <joint name="HR_Knee_joint" type="hinge" class="motor" axis="0 -1 0"
                   range="0.5236 2.7225" damping="0.01" frictionloss="0.03"/>
            <inertial pos="0.0064794 -1.4529e-06 -0.12157" mass="0.18206"
                      diaginertia="0.00089039 0.00090672 3.1266e-05"/>
            <geom name="HR_SHANK_collision" type="mesh" mesh="hr_shank" class="collision"/>
            <geom name="HR_SHANK_visual" type="mesh" mesh="hr_shank" class="visual"/>
            <body name="HR_FOOT" pos="0 0 -0.22">
              <inertial pos="0 0 0" mass="0.06" diaginertia="1e-12 1e-12 1e-12"/>
              <geom name="HR_FOOT_collision" type="sphere" size="0.02" class="collision"/>
              <geom name="HR_FOOT_visual" type="sphere" size="0.022" class="visual"/>
            </body>
          </body>
        </body>
      </body>

      <site name="TORSO_site" pos="0 0 0"/>
      <camera name="front_camera" mode="track" fovy="90"
              quat="4.329780281177467e-17 4.329780281177466e-17 0.7071067811865475 0.7071067811865476"
              pos="0 2 0.5"/>
      <camera name="side_camera" mode="track" fovy="90"
              quat="-0.5 -0.5 0.5 0.5" pos="-2 0 0.5"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="FL_HipX_joint_ctrl" joint="FL_HipX_joint" class="motor" gear="1" ctrlrange="-46 46"/>
    <motor name="FL_HipY_joint_ctrl" joint="FL_HipY_joint" class="motor" gear="1" ctrlrange="-46 46"/>
    <motor name="FL_Knee_joint_ctrl" joint="FL_Knee_joint" class="motor" gear="1" ctrlrange="-59 59"/>
    <motor name="FR_HipX_joint_ctrl" joint="FR_HipX_joint" class="motor" gear="1" ctrlrange="-46 46"/>
    <motor name="FR_HipY_joint_ctrl" joint="FR_HipY_joint" class="motor" gear="1" ctrlrange="-46 46"/>
    <motor name="FR_Knee_joint_ctrl" joint="FR_Knee_joint" class="motor" gear="1" ctrlrange="-59 59"/>
    <motor name="HL_HipX_joint_ctrl" joint="HL_HipX_joint" class="motor" gear="1" ctrlrange="-46 46"/>
    <motor name="HL_HipY_joint_ctrl" joint="HL_HipY_joint" class="motor" gear="1" ctrlrange="-46 46"/>
    <motor name="HL_Knee_joint_ctrl" joint="HL_Knee_joint" class="motor" gear="1" ctrlrange="-59 59"/>
    <motor name="HR_HipX_joint_ctrl" joint="HR_HipX_joint" class="motor" gear="1" ctrlrange="-46 46"/>
    <motor name="HR_HipY_joint_ctrl" joint="HR_HipY_joint" class="motor" gear="1" ctrlrange="-46 46"/>
    <motor name="HR_Knee_joint_ctrl" joint="HR_Knee_joint" class="motor" gear="1" ctrlrange="-59 59"/>
  </actuator>

  <contact>
    <exclude body1="TORSO" body2="FL_HIP"/>
    <exclude body1="FL_HIP" body2="FL_THIGH"/>
    <exclude body1="FL_THIGH" body2="FL_SHANK"/>
    <exclude body1="FL_SHANK" body2="FL_FOOT"/>
    <exclude body1="TORSO" body2="FR_HIP"/>
    <exclude body1="FR_HIP" body2="FR_THIGH"/>
    <exclude body1="FR_THIGH" body2="FR_SHANK"/>
    <exclude body1="FR_SHANK" body2="FR_FOOT"/>
    <exclude body1="TORSO" body2="HL_HIP"/>
    <exclude body1="HL_HIP" body2="HL_THIGH"/>
    <exclude body1="HL_THIGH" body2="HL_SHANK"/>
    <exclude body1="HL_SHANK" body2="HL_FOOT"/>
    <exclude body1="TORSO" body2="HR_HIP"/>
    <exclude body1="HR_HIP" body2="HR_THIGH"/>
    <exclude body1="HR_THIGH" body2="HR_SHANK"/>
    <exclude body1="HR_SHANK" body2="HR_FOOT"/>
  </contact>

  <sensor>
    <framepos name="TORSO_site_pos" objtype="site" objname="TORSO_site"/>
    <framequat name="TORSO_site_quat" objtype="site" objname="TORSO_site"/>
    <framelinvel name="TORSO_site_linvel" objtype="site" objname="TORSO_site"/>
    <frameangvel name="TORSO_site_angvel" objtype="site" objname="TORSO_site"/>
    <velocimeter name="TORSO_site_vel" site="TORSO_site"/>
    <accelerometer name="imu_accelerometer" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
  </sensor>
</mujoco>
